# Base URL of the FastAPI backend. Read at build time by src/lib/api.ts.
#
# 127.0.0.1, not localhost: uvicorn binds IPv4 only, and a SYN to [::1]:8000 on Windows
# is dropped rather than refused, so "localhost" costs ~200ms per connection waiting out
# the IPv6 attempt before it falls back. Only use "localhost" if uvicorn is bound to ::
# as well (--host ::).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

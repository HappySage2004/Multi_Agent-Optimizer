# Large source data (provision separately)
datasets/ridership_actuals.csv

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo

# Secrets
.env
.env.*
!.env.example

# Generated artifacts & local DB derivatives
backend/artifacts/
*.duckdb
*.parquet

# The app database: sessions, chat transcripts, runs, uploads. Local application state,
# not source. Committing it is what produced a real bug — a run record cloned from another
# machine carries that machine's absolute artifact paths while backend/artifacts/ is
# ignored, so the run arrives referencing parquet that was never here. Transcripts are
# worse: they are the user's own conversations.
# sessions.json, runs.json and uploads.json are already tracked; `git rm --cached` them to
# finish the job.
localDB/*.json

# User-uploaded documents (keep the folder, not the contents)
stage/*
!stage/.gitkeep

# OS / editor
.DS_Store

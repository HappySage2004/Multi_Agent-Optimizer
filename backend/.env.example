# The shared keys live in the repo-root .env, which is gitignored.
# Use backend/.env only to override something locally.
#
# Two providers, picked per request from the UI (Settings -> Model). MODEL_PROVIDER is
# only the default for a request that names neither a provider nor a model.
MODEL_PROVIDER=gemini          # gemini | azure_openai

# --- Google Gemini ---------------------------------------------------------------
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.5-flash-lite
# Everything the picker may offer on this provider (GEMINI_MODEL is always included).
# GEMINI_MODELS=["gemini-3.5-flash-lite"]

# --- Azure OpenAI ----------------------------------------------------------------
AZURE_OPENAI_API_KEY=...
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_MODEL=gpt-5.4-mini
# model name the picker shows -> the DEPLOYMENT name the API wants. Not the same
# string on Azure: sending the model name gets a 404. Defaults are in app/config.py.
# AZURE_OPENAI_DEPLOYMENTS={"gpt-5.4-nano": "Team7-...", "gpt-5.4-mini": "Pod3-..."}

# Optional per-tier overrides. Applied only when the id names a model the selected
# provider offers, so one left pointing at Gemini does not follow you to Azure.
# MASTER_MODEL=gemini-3.5-flash-lite
# SPECIALIST_MODEL=gemini-3.5-flash-lite

# Client-side request caps, per provider.
# MODEL_REQUESTS_PER_MINUTE=12
# AZURE_REQUESTS_PER_MINUTE=60

# Optional pipeline tuning
# CANDIDATE_POOL_SIZE=250

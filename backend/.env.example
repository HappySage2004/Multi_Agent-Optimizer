# The shared key lives in the repo-root .env, which is gitignored.
# Use backend/.env only to override something locally.
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional per-tier model overrides (both default to GEMINI_MODEL)
# MASTER_MODEL=gemini-3.5-flash-lite
# SPECIALIST_MODEL=gemini-3.5-flash-lite

# Optional pipeline tuning
# CANDIDATE_POOL_SIZE=250
